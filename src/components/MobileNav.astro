---
import { site } from '../config/site';
import { t, langOf, localePath, type Lang } from '../i18n';
interface Props { lang?: Lang }
const lang = langOf(Astro.props.lang);
const wa = site.contact.whatsapp ? `https://wa.me/${site.contact.whatsapp}` : null;
const items = [
  { href: localePath(lang, '/'), label: t(lang, 'nav.home'), c: 'r', d: 'M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { href: localePath(lang, '/products'), label: t(lang, 'nav.products'), c: 'o', d: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z' },
  { href: localePath(lang, '/screens'), label: t(lang, 'nav.screens'), c: 'y', d: 'M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm5 17a1 1 0 1 0 0 .01' },
  { href: localePath(lang, '/cart'), label: t(lang, 'nav.cart'), c: 'g', d: 'M3 4h2l2.4 11h10.2L20 7H6.2M9 20a1 1 0 1 0 0 .01M17 20a1 1 0 1 0 0 .01', cart: true },
];
---
<nav class="mnav" aria-label="mobile">
  {items.map((i) => (
    <a href={i.href} class={`mi ${i.c}`} data-path={i.href}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={i.d} /></svg>
      {i.cart ? <span class="mb" data-cart-count hidden>0</span> : null}
      <span>{i.label}</span>
    </a>
  ))}
  {wa ? <a href={wa} class="mi w" rel="noopener"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-4-7.5L21 3l-1.5 4A9 9 0 0 1 21 12zM8.5 9.5c.5 3 3 5.5 6 6l1.5-1.5-2-1-1 .7a4 4 0 0 1-2-2l.7-1-1-2z" /></svg><span>{t(lang, 'nav.whatsapp')}</span></a> : null}
</nav>
<script is:inline>
  document.querySelectorAll('.mnav .mi[data-path]').forEach(function (a) {
    var p = a.getAttribute('data-path'), l = location.pathname;
    if (p === l || (p.length > 4 && l.indexOf(p) === 0)) a.classList.add('on');
  });
</script>
<style>
  .mnav { display: none; }
  @media (max-width: 719px) {
    .mnav { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; position: fixed; inset-inline: 0; bottom: 0; z-index: 40; background: #fff; border-top: 3px solid transparent; border-image: linear-gradient(90deg, var(--air-red), var(--air-orange) 33%, var(--air-yellow) 66%, var(--air-green)) 1; box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.08); padding-bottom: env(safe-area-inset-bottom); }
    .mi { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 56px; font-size: 0.7rem; font-weight: 700; color: var(--c-muted); text-decoration: none; }
    .mi.r { --a: var(--air-red); } .mi.o { --a: var(--air-orange); } .mi.y { --a: #c99700; } .mi.g, .mi.w { --a: var(--air-green); }
    .mi.on { color: var(--a); }
    .mi.on::before { content: ''; position: absolute; top: 0; width: 28px; height: 3px; border-radius: 0 0 4px 4px; background: var(--a); }
    .mi:active { transform: scale(0.94); }
    .mb { position: absolute; top: 5px; inset-inline-start: calc(50% + 6px); min-width: 17px; height: 17px; padding: 0 4px; border-radius: 9px; background: var(--air-red); color: #fff; font-size: 0.65rem; line-height: 17px; text-align: center; }
  }
</style>
