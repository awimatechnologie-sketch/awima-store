---
import { localizedSite } from '../config/site';
import { formatPrice } from '../lib/format';
import { t, langOf, type Lang } from '../i18n';
interface Props { lang?: Lang }
const lang = langOf(Astro.props.lang);
const cities = localizedSite(lang).cities;
---
<ul class="cities">
  {cities.map((c) => (
    <li class:list={['city', { locked: !c.open }]}>
      <span>{c.name}</span>
      {c.open ? <small class="ok">{t(lang, 'contact.available')}{c.fee !== null ? ` · ${t(lang, 'contact.deliveryFee', { fee: formatPrice(c.fee, lang) })}` : ''}</small> : <small>{t(lang, 'city.soon')}</small>}
    </li>
  ))}
</ul>
<style>
  .cities { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .city { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--c-border); border-radius: 999px; background: #fff; font-weight: 600; }
  .city small { font-weight: 600; color: var(--c-muted); }
  .city .ok { color: #0e6e3c; }
  .locked { background: var(--c-surface); color: var(--c-muted); }
</style>
