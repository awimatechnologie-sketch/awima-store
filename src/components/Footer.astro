---
import { site, localizedSite } from '../config/site';
import { t, langOf, localePath, type Lang } from '../i18n';
import HoursBadge from './HoursBadge.astro';
interface Props { lang?: Lang }
const lang = langOf(Astro.props.lang);
const socials = Object.entries(site.social).filter(([, url]) => url);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container cols">
    <div>
      <img src={site.logo.store} alt={site.name} width="190" height="74" loading="lazy" />
      <p>{localizedSite(lang).tagline}</p>
    </div>
    <div>
      <h3>{t(lang, 'footer.contact')}</h3>
      {site.contact.whatsapp ? <p><a href={`https://wa.me/${site.contact.whatsapp}`}>{t(lang, 'footer.whatsappPhone', { phone: site.contact.phoneDisplay })}</a></p> : null}
      {site.contact.whatsappSecondary ? <p><a href={`https://wa.me/${site.contact.whatsappSecondary}`}>{t(lang, 'footer.whatsappPhone', { phone: site.contact.phoneSecondaryDisplay })}</a></p> : null}
      {site.contact.email ? <p>{site.contact.email}</p> : null}
      {site.contact.address ? <p>{site.contact.address}</p> : null}
      <p><HoursBadge light lang={lang} /></p>
    </div>
    <div>
      <h3>{t(lang, 'footer.links')}</h3>
      <p><a href={localePath(lang, '/products')}>{t(lang, 'nav.products')}</a></p>
      <p><a href={localePath(lang, '/cart')}>{t(lang, 'nav.cart')}</a></p>
      <p><a href={localePath(lang, '/awima-box')}>{t(lang, 'nav.awimaBox')}</a></p>
      <p><a href={localePath(lang, '/compat')}>{t(lang, 'nav.compat')}</a></p>
      {site.warranty.enabled ? <p><a href={localePath(lang, '/policy')}>{t(lang, 'footer.policy')}</a></p> : null}
      <p><a href={localePath(lang, '/about')}>{t(lang, 'nav.about')}</a></p>
      <p><a href={localePath(lang, '/contact')}>{t(lang, 'nav.contact')}</a></p>
      {socials.map(([name, url]) => (
        <p><a href={url} rel="noopener" target="_blank">{name}</a></p>
      ))}
      <p><button type="button" class="install" data-install-app hidden>{t(lang, 'pwa.install')}</button></p>
    </div>
  </div>
  <div class="copy container">© {year} {site.name}</div>
</footer>
<style>
  .footer { background: var(--c-primary); color: #fff; padding-top: 40px; }
  .cols { display: grid; gap: 24px; }
  .footer h3 { color: #fff; }
  .footer a { color: #cfe0ff; text-decoration: none; }
  .footer a:hover { text-decoration: underline; }
  .footer img { height: 74px; width: auto; background: #fff; border-radius: 10px; padding: 6px 10px; margin-bottom: 8px; }
  .footer p { margin: 0 0 6px; }
  .install { font: inherit; font-weight: 700; padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.5); background: transparent; color: #fff; cursor: pointer; }
  .install:hover { background: rgba(255, 255, 255, 0.12); }
  .copy { text-align: center; padding-block: 20px; margin-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.2); font-size: 0.9rem; }
  @media (min-width: 720px) { .cols { grid-template-columns: 2fr 1.5fr 1fr; } }
</style>
