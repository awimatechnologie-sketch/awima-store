---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { site, localizedSite } from '../config/site';
import { buildContactLink } from '../lib/whatsapp';
import { buildStoreLd } from '../lib/seo';
import { getCategories, getFeaturedProducts } from '../services/products';
import { t, langOf, localePath, type Lang } from '../i18n';

interface Props { lang?: Lang }
const lang = langOf(Astro.props.lang);
const ls = localizedSite(lang);
const categories = getCategories(lang);
const featured = getFeaturedProducts(4, lang);
const categoryName = Object.fromEntries(categories.map((c) => [c.id, c.name]));
const waLink = buildContactLink(undefined, lang);
const storeLd = buildStoreLd({ ...site, tagline: ls.tagline, cities: ls.cities });
const reasons = [1, 2, 3, 4].map((n) => ({ t: t(lang, `home.r${n}.t`), d: t(lang, `home.r${n}.d`) }));
---
<BaseLayout lang={lang} description={t(lang, 'home.description')}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(storeLd).replace(/</g, '\\u003c')} />

  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>{ls.tagline}</h1>
        <p class="lead">{t(lang, 'home.lead')}</p>
        <div class="actions">
          <a class="btn btn-primary" href={localePath(lang, '/products')}>{t(lang, 'home.browse')}</a>
          <a class="btn btn-wa" href={waLink} target="_blank" rel="noopener">{t(lang, 'home.orderWa')}</a>
        </div>
      </div>
      <div class="hero-logo card">
        <img src={site.logo.store} alt={site.name} width="480" height="186" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cats">
    <div class="container">
      <h2 id="cats">{t(lang, 'home.shopByCat')}</h2>
      <div class="grid grid-4">
        {categories.map((c) => (
          <a class="card cat" href={localePath(lang, `/products?category=${c.slug}`)}>{c.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="feat">
    <div class="container">
      <div class="section-head">
        <h2 id="feat">{t(lang, 'home.featured')}</h2>
        <a class="link-more" href={localePath(lang, '/products')}>{t(lang, 'home.viewAll')}</a>
      </div>
      <div class="grid grid-4">
        {featured.map((p) => (
          <ProductCard product={p} categoryName={categoryName[p.category]} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <section class="promo">
    <div class="container">
      <h2>{t(lang, 'home.promoTitle')}</h2>
      <p>{t(lang, 'home.promoText')}</p>
      <a class="btn btn-wa" href={waLink} target="_blank" rel="noopener">{t(lang, 'home.startChat')}</a>
    </div>
  </section>

  <section class="section" aria-labelledby="why">
    <div class="container">
      <h2 id="why">{t(lang, 'home.why')}</h2>
      <div class="grid grid-4">
        {reasons.map((r) => (
          <div class="card why">
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="talk">
    <div class="container talk">
      <h2 id="talk">{t(lang, 'home.talk')}</h2>
      <p>{t(lang, 'home.talkText')}</p>
      <div class="actions">
        <a class="btn btn-wa" href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener">{site.contact.phoneDisplay}</a>
        <a class="btn btn-outline" href={`https://wa.me/${site.contact.whatsappSecondary}`} target="_blank" rel="noopener">{site.contact.phoneSecondaryDisplay}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: linear-gradient(180deg, var(--c-surface), #fff); padding-block: 32px; }
  .hero-grid { display: grid; gap: 24px; align-items: center; }
  .lead { color: var(--c-muted); font-size: 1.1rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-logo { padding: 20px; max-width: 420px; width: 100%; justify-self: center; }
  .cat { display: grid; place-items: center; min-height: 90px; font-weight: 700; color: var(--c-primary); text-decoration: none; text-align: center; padding: 12px; }
  .cat:hover { border-color: var(--c-accent); }
  .promo { background: var(--c-primary); color: #fff; padding-block: 40px; text-align: center; }
  .promo h2 { color: #fff; }
  .why { padding: 18px; }
  .why h3 { font-size: 1.05rem; }
  .why p { margin: 0; color: var(--c-muted); font-size: 0.95rem; }
  .talk { text-align: center; }
  .talk .actions { justify-content: center; }
  @media (min-width: 860px) {
    .hero { padding-block: 64px; }
    .hero-grid { grid-template-columns: 1.3fr 1fr; }
  }
</style>
