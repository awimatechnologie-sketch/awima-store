---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { site, localizedSite } from '../config/site';
import { buildContactLink } from '../lib/whatsapp';
import { buildStoreLd } from '../lib/seo';
import { getCategories, getFeaturedProducts, getAllProducts } from '../services/products';
import { buildTrustItems } from '../lib/trust';
import { hoursLabel } from '../lib/hours';
import { formatPrice } from '../lib/format';
import { t, langOf, localePath, type Lang } from '../i18n';

interface Props { lang?: Lang }
const lang = langOf(Astro.props.lang);
const ls = localizedSite(lang);
const categories = getCategories(lang);
const featured = getFeaturedProducts(4, lang);
const categoryName = Object.fromEntries(categories.map((c) => [c.id, c.name]));
const waLink = buildContactLink(undefined, lang);
const storeLd = buildStoreLd({ ...site, tagline: ls.tagline, cities: ls.cities });
const trustItems = buildTrustItems(
  site.trustStrip,
  { fastDelivery: site.fastDelivery, freeDeliveryFrom: site.freeDeliveryFrom, warrantyEnabled: site.warranty.enabled, hoursRange: t(lang, 'hours.label', { range: hoursLabel(site.hours.open, site.hours.close, lang) }) },
  (k, v) => t(lang, k, v),
  (n) => formatPrice(n, lang),
  lang,
  localePath(lang, '/policy')
);
const ls2 = site.community.likedSection;
const likedPool = site.community.likesEnabled && ls2.enabled
  ? getAllProducts(lang).map((p) => ({ id: p.id, name: p.name, href: localePath(lang, `/products/${p.slug}`), img: p.images[0] ?? '/images/placeholder.svg', price: formatPrice(p.price, lang) }))
  : [];
const reasons = [1, 2, 3, 4].map((n) => ({ t: t(lang, `home.r${n}.t`), d: t(lang, `home.r${n}.d`) }));
---
<BaseLayout lang={lang} description={t(lang, 'home.description')}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(storeLd).replace(/</g, '\\u003c')} />

  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>{ls.tagline}</h1>
        <p class="lead">{t(lang, 'home.lead')}</p>
        <div class="actions">
          <a class="btn btn-primary" href={localePath(lang, '/products')}>{t(lang, 'home.browse')}</a>
          <a class="btn btn-wa" href={waLink} target="_blank" rel="noopener">{t(lang, 'home.orderWa')}</a>
        </div>
      </div>
      <div class="hero-logo card">
        <img src={site.logo.store} alt={site.name} width="480" height="186" />
      </div>
    </div>
  </section>

  {trustItems.length > 0 && (
    <section class="trust" aria-label={t(lang, 'home.why')}>
      <ul class="container trust-list">
        {trustItems.map((i) => (
          <li>{i.href ? <a href={i.href}><span aria-hidden="true">{i.icon}</span> {i.text}</a> : <span><span aria-hidden="true">{i.icon}</span> {i.text}</span>}</li>
        ))}
      </ul>
    </section>
  )}

  <section class="section" aria-labelledby="cats">
    <div class="container">
      <h2 id="cats">{t(lang, 'home.shopByCat')}</h2>
      <div class="grid grid-4">
        {categories.filter((c) => !c.parent).map((c) => (
          <a class="card cat" href={localePath(lang, `/products?category=${c.slug}`)}>{c.icon ? <span class="ic" aria-hidden="true">{c.icon}</span> : null}<span>{c.name}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="feat">
    <div class="container">
      <div class="section-head">
        <h2 id="feat">{t(lang, 'home.featured')}</h2>
        <a class="link-more" href={localePath(lang, '/products')}>{t(lang, 'home.viewAll')}</a>
      </div>
      <div class="grid grid-4">
        {featured.map((p) => (
          <ProductCard product={p} categoryName={categoryName[p.category]} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  {likedPool.length > 0 && (
    <section class="section" id="liked" aria-labelledby="likedh" hidden data-pool={JSON.stringify(likedPool)} data-count={ls2.count} data-min={ls2.minLikes}>
      <div class="container">
        <div class="section-head">
          <h2 id="likedh">❤️ {t(lang, 'home.liked')}</h2>
          <a class="link-more" href={localePath(lang, '/products?sort=likes')}>{t(lang, 'home.viewAll')}</a>
        </div>
        <ul class="grid grid-4 liked-list" id="liked-list"></ul>
      </div>
    </section>
  )}

  <section class="promo">
    <div class="container">
      <h2>{t(lang, 'home.promoTitle')}</h2>
      <p>{t(lang, 'home.promoText')}</p>
      <a class="btn btn-wa" href={waLink} target="_blank" rel="noopener">{t(lang, 'home.startChat')}</a>
    </div>
  </section>

  <section class="section" aria-labelledby="why">
    <div class="container">
      <h2 id="why">{t(lang, 'home.why')}</h2>
      <div class="grid grid-4">
        {reasons.map((r) => (
          <div class="card why">
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="talk">
    <div class="container talk">
      <h2 id="talk">{t(lang, 'home.talk')}</h2>
      <p>{t(lang, 'home.talkText')}</p>
      <div class="actions">
        <a class="btn btn-wa" href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener">{site.contact.phoneDisplay}</a>
        <a class="btn btn-outline" href={`https://wa.me/${site.contact.whatsappSecondary}`} target="_blank" rel="noopener">{site.contact.phoneSecondaryDisplay}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // «الأكثر إعجاباً»: تُبنى من عدّادات الإعجاب الحقيقية، وتبقى مخفية حتى يبلغ منتج الحد الأدنى
  const sec = document.getElementById('liked');
  if (sec) {
    const show = (data: { likes: Record<string, number> }) => {
      type P = { id: string; name: string; href: string; img: string; price: string };
      let pool: P[] = [];
      try { pool = JSON.parse(sec.dataset.pool || '[]'); } catch { return; }
      const min = Number(sec.dataset.min || 3), count = Number(sec.dataset.count || 4);
      const top = pool.filter((p) => (data.likes[p.id] ?? 0) >= min).sort((a, b) => (data.likes[b.id] ?? 0) - (data.likes[a.id] ?? 0)).slice(0, count);
      if (!top.length) return;
      const ul = document.getElementById('liked-list')!;
      ul.innerHTML = '';
      for (const p of top) {
        const li = document.createElement('li'); li.className = 'card lk';
        const a = document.createElement('a'); a.href = p.href;
        const img = document.createElement('img'); img.src = p.img; img.alt = p.name; img.loading = 'lazy'; img.width = 400; img.height = 400;
        const nm = document.createElement('strong'); nm.textContent = p.name;
        const pr = document.createElement('span'); pr.className = 'pr'; pr.textContent = p.price;
        const n = document.createElement('small'); n.textContent = `♥ ${data.likes[p.id]}`;
        a.append(img, nm, pr, n); li.append(a); ul.append(li);
      }
      sec.hidden = false;
    };
    const w = window as unknown as { __awimaData?: { likes: Record<string, number> } };
    if (w.__awimaData) show(w.__awimaData);
    window.addEventListener('awima:data', (e) => show((e as CustomEvent).detail));
  }
</script>
<style>
  .hero { background: linear-gradient(180deg, var(--c-surface), #fff); padding-block: 32px; }
  .hero-grid { display: grid; gap: 24px; align-items: center; }
  .lead { color: var(--c-muted); font-size: 1.1rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-logo { padding: 20px; max-width: 420px; width: 100%; justify-self: center; }
  .trust { background: #fff; border-bottom: 1px solid var(--c-border); }
  .trust-list { list-style: none; margin: 0 auto; padding-block: 10px; display: flex; flex-wrap: wrap; gap: 6px 22px; justify-content: center; font-size: 0.92rem; font-weight: 600; color: var(--c-primary); }
  .trust-list a { color: inherit; text-decoration: none; }
  .trust-list a:hover { text-decoration: underline; }
  .liked-list { list-style: none; padding: 0; margin: 0; }
  .lk a { display: grid; gap: 4px; padding: 0 0 12px; text-decoration: none; color: var(--c-text); }
  .lk img { width: 100%; aspect-ratio: 1; object-fit: cover; background: var(--c-surface); border-radius: var(--radius) var(--radius) 0 0; }
  .lk strong, .lk .pr, .lk small { padding-inline: 12px; }
  .lk .pr { color: var(--c-accent); font-weight: 800; }
  .lk small { color: #e4161b; font-weight: 700; }
  .ic { font-size: 1.8rem; line-height: 1; }
  .cat { display: grid; place-items: center; gap: 6px; min-height: 90px; font-weight: 700; color: var(--c-primary); text-decoration: none; text-align: center; padding: 12px; }
  .cat:hover { border-color: var(--c-accent); }
  .promo { background: var(--c-primary); color: #fff; padding-block: 40px; text-align: center; }
  .promo h2 { color: #fff; }
  .why { padding: 18px; }
  .why h3 { font-size: 1.05rem; }
  .why p { margin: 0; color: var(--c-muted); font-size: 0.95rem; }
  .talk { text-align: center; }
  .talk .actions { justify-content: center; }
  @media (min-width: 860px) {
    .hero { padding-block: 64px; }
    .hero-grid { grid-template-columns: 1.3fr 1fr; }
  }
</style>
