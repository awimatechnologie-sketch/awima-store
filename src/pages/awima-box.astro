---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProductsByCategory } from '../services/products';
import { buildContactLink } from '../lib/whatsapp';
import boxAr from '../data/pages/awima-box.json';
import boxFr from '../data/pages/awima-box.fr.json';
import { t, langOf, type Lang } from '../i18n';

interface Props { lang?: Lang }
const lang = langOf(Astro.props.lang);
const box = lang === 'fr' ? boxFr : boxAr;
const products = getProductsByCategory('cat-awima-box', lang);
const steps = (box.steps ?? []).filter((s) => s?.title);
const benefits = (box.benefits ?? []).filter(Boolean);
const appFeatures = ((box as { appFeatures?: string[] }).appFeatures ?? []).filter(Boolean);
const appShots = ((box as { appShots?: { image?: string; caption?: string }[] }).appShots ?? []).filter((s) => s?.image);
const appShotsTitle = (box as { appShotsTitle?: string }).appShotsTitle;
---
<BaseLayout lang={lang} title={box.title} description={box.intro}>
  <section class="hero">
    <div class="container">
      <h1>{box.title}</h1>
      {box.tagline && <p class="tag">{box.tagline}</p>}
      {box.intro && <p class="intro">{box.intro}</p>}
      <div class="actions">
        <a class="btn btn-wa" href={buildContactLink(box.ctaText, lang)} target="_blank" rel="noopener">{t(lang, 'box.askWa')}</a>
        {products.length > 0 && <a class="btn btn-light" href="#boxes">{t(lang, 'box.seeBoxes')}</a>}
      </div>
    </div>
  </section>

  {steps.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>{t(lang, 'box.how')}</h2>
        <ol class="steps">
          {steps.map((s, i) => (
            <li class="card">
              <span class="num">{i + 1}</span>
              <h3>{s.title}</h3>
              {s.text && <p>{s.text}</p>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="section section-alt" id="boxes">
    <div class="container">
      <h2>{box.productsTitle || t(lang, 'box.productsTitle')}</h2>
      {products.length > 0 ? (
        <ul class="grid grid-4 list">
          {products.map((p) => (
            <li><ProductCard product={p} categoryName="Awima Box" lang={lang} /></li>
          ))}
        </ul>
      ) : (
        <div class="card empty">
          <p>{box.emptyText}</p>
          <a class="btn btn-wa" href={buildContactLink(box.ctaText, lang)} target="_blank" rel="noopener">{t(lang, 'box.contactWa')}</a>
        </div>
      )}
    </div>
  </section>

  {(benefits.length > 0 || box.appText) && (
    <section class="section">
      <div class="container two">
        {benefits.length > 0 && (
          <div>
            <h2>{t(lang, 'box.why')}</h2>
            <ul class="benefits">{benefits.map((b) => <li>{b}</li>)}</ul>
          </div>
        )}
        {box.appText && (
          <div class="card app">
            <h2>{box.appTitle}</h2>
            <p>{box.appText}</p>
            {appFeatures.length > 0 && (
              <ul class="features">{appFeatures.map((f) => <li>{f}</li>)}</ul>
            )}
          </div>
        )}
      </div>
    </section>
  )}

  {appShots.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <h2>{appShotsTitle || t(lang, 'box.shots')}</h2>
        <ul class="shots">
          {appShots.map((s) => (
            <li>
              <figure>
                <img src={s.image} alt={s.caption || box.appTitle} width="360" height="800" loading="lazy" decoding="async" />
                {s.caption && <figcaption>{s.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
<style>
  .hero { background: var(--c-primary); color: #fff; padding-block: 48px; }
  .hero h1 { margin: 0 0 8px; color: #fff; font-size: 2rem; }
  .tag { margin: 0 0 12px; color: #cfe0ff; font-weight: 600; font-size: 1.1rem; }
  .intro { max-width: 640px; line-height: 1.9; margin: 0 0 20px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn-light { background: #fff; color: var(--c-primary); }
  h2 { margin: 0 0 16px; color: var(--c-primary); }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  .steps .card { padding: 20px; }
  .steps h3 { margin: 8px 0 4px; }
  .steps p { margin: 0; color: var(--c-muted); line-height: 1.8; }
  .num { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--c-accent); color: #fff; font-weight: 700; }
  .list { list-style: none; padding: 0; margin: 0; }
  .empty { text-align: center; padding: 32px 16px; }
  .empty p { color: var(--c-muted); margin: 0 0 16px; }
  .two { display: grid; gap: 24px; }
  .benefits { padding-inline-start: 20px; line-height: 2.1; color: var(--c-muted); margin: 0; }
  .app { padding: 20px; }
  .app p { margin: 0; line-height: 1.9; color: var(--c-muted); }
  .features { margin: 14px 0 0; padding-inline-start: 20px; line-height: 2; color: var(--c-text, inherit); }
  .shots { list-style: none; padding: 0; margin: 0; display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; }
  .shots li { flex: 0 0 62%; max-width: 260px; scroll-snap-align: start; }
  .shots figure { margin: 0; }
  .shots img { width: 100%; height: auto; border-radius: 18px; border: 1px solid var(--c-border, #e2e8f0); background: #fff; display: block; }
  .shots figcaption { margin-top: 8px; font-size: .9rem; font-weight: 600; text-align: center; color: var(--c-muted); }
  @media (min-width: 720px) {
    .steps { grid-template-columns: repeat(3, 1fr); }
    .two { grid-template-columns: 1fr 1fr; }
    .hero h1 { font-size: 2.6rem; }
    .shots { overflow: visible; display: grid; grid-template-columns: repeat(4, 1fr); }
    .shots li { max-width: none; }
  }
</style>
