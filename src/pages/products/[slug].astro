---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { site } from '../../config/site';
import { buildProductLink } from '../../lib/whatsapp';
import { formatPrice, getSaving, availabilityFor } from '../../lib/format';
import { t, langOf, localePath, type Lang } from '../../i18n';
import { pickRelated } from '../../lib/related';
import { isLowStock } from '../../lib/stock';
import { warrantyDaysFor, warrantyUnit } from '../../lib/warranty';
import { starsHtml, isTrusted } from '../../lib/community';
import { getAllProducts, getCategories, getProductBySlug } from '../../services/products';
import { getReviewSummary, getReviews } from '../../services/reviews';
import { badgeOffersFor, moroccoToday } from '../../lib/offers';

export function getStaticPaths() {
  return getAllProducts().map((p) => ({ params: { slug: p.slug } }));
}

interface Props { lang?: Lang }
const lang = langOf(Astro.props.lang);
const { slug } = Astro.params;
const product = getProductBySlug(slug as string, lang)!;
const categories = getCategories(lang);
const category = categories.find((c) => c.id === product.category);
const parentCat = category?.parent ? categories.find((c) => c.id === category.parent) : undefined;
const catName = Object.fromEntries(categories.map((c) => [c.id, c.name]));

const pageUrl = new URL(localePath(lang, `/products/${product.slug}`), site.url).href;
const waLink = buildProductLink(product, pageUrl, lang);
const av = availabilityFor(lang, product.availability);
const wDays = warrantyDaysFor(site.warranty, product.warranty);
const wu = wDays ? warrantyUnit(wDays) : null;
const wNote = lang === 'fr' ? site.warranty.noteFr || site.warranty.note : site.warranty.note;
const saving = getSaving(product.price, product.oldPrice);
const today = moroccoToday();
const offers = badgeOffersFor(site.autoOffers, product, today).map((o) => ({
  o,
  value: o.type === 'percent' ? `${o.value}%` : formatPrice(o.value, lang),
  name: lang === 'fr' && o.nameFr ? o.nameFr : o.name,
}));
const images = product.images.length ? product.images : ['/images/placeholder.svg'];
const specs = Object.entries(product.specs ?? {});
const phoneHref = `tel:+${site.contact.whatsapp}`;

const related = pickRelated(product, getAllProducts(lang), 4);
const rv = getReviewSummary(product.id);
const reviews = getReviews(product.id).slice(0, 20);
const hasTier = rv.tier !== 'none';
const cm = site.community;
const trusted = isTrusted(rv, !!product.trusted, cm.crown);
const fmtAvg = (n: number) => (lang === 'fr' ? String(n).replace('.', ',') : String(n));
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const sep = lang === 'fr' ? '›' : '‹';

const ld: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: images.map((i) => new URL(i, site.url).href),
  description: product.description,
  sku: product.id,
};
if (product.price !== null) {
  ld.offers = {
    '@type': 'Offer',
    price: String(product.price),
    priceCurrency: site.currency,
    url: pageUrl,
    ...(product.availability === 'in_stock' ? { availability: 'https://schema.org/InStock' } : {}),
    ...(product.availability === 'out_of_stock' ? { availability: 'https://schema.org/OutOfStock' } : {}),
  };
}
---
<BaseLayout
  lang={lang}
  title={product.name}
  description={product.shortDescription}
  image={images[0]}
  ogType="product"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />

  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label={t(lang, 'nav.breadcrumb')}>
        <a href={localePath(lang, '/')}>{t(lang, 'nav.home')}</a> {sep} <a href={localePath(lang, '/products')}>{t(lang, 'nav.products')}</a>
        {parentCat ? <> {sep} <a href={localePath(lang, `/products?category=${parentCat.slug}`)}>{parentCat.name}</a></> : null}
        {category ? <> {sep} <a href={localePath(lang, `/products?category=${category.slug}`)}>{category.name}</a></> : null}
      </nav>

      <div class="layout">
        <div class="gallery">
          <div class="main card">
            <img id="main-img" src={images[0]} alt={product.name} width="800" height="800" fetchpriority="high" />
          </div>
          {images.length > 1 ? (
            <div class="thumbs" role="group" aria-label={t(lang, 'product.gallery')}>
              {images.map((src, i) => (
                <button type="button" class="thumb" data-src={src} aria-current={i === 0 ? 'true' : undefined} aria-label={t(lang, 'product.imageN', { n: i + 1 })}>
                  <img src={src} alt="" width="120" height="120" loading="lazy" />
                </button>
              ))}
            </div>
          ) : null}
        </div>

        <div class="info">
          {category ? <span class="cat">{category.name}</span> : null}
          <h1>{product.name}</h1>
          {cm.crown.enabled ? <p class="crown-line" data-pid-crown={product.id} hidden={!trusted}><span class="crown-inline">👑 {t(lang, 'community.crown')}</span></p> : null}
          <p class="ref">{t(lang, 'product.ref', { id: product.id })}</p>

          <p class="prices">
            <span class="price">{formatPrice(product.price, lang)}</span>
            {saving ? <del class="old">{formatPrice(product.oldPrice, lang)}</del> : null}
            {saving ? <span class="save">{t(lang, 'price.save', { amount: formatPrice(saving, lang) })}</span> : null}
          </p>
          {offers.map(({ o, value, name }) => (
            <p class="offer-banner" data-offer-start={o.start ?? undefined} data-offer-end={o.end ?? undefined} hidden={!!o.start && today < o.start}>
              🏷️ {t(lang, o.minQty > 1 ? 'offer.banner.min' : 'offer.banner.single', { name, value, n: o.minQty })}{o.end ? ' ' + t(lang, 'offer.until', { date: o.end }) : ''}
            </p>
          ))}
          <span class={`badge ${av.cls}`}>{av.text}</span>
          {isLowStock(product.stock) ? <span class="low">{t(lang, 'product.lowStock', { n: product.stock as number })}</span> : null}

          {product.availability === 'on_request' && product.leadDays ? <p class="lead-days">⏱️ {t(lang, 'product.lead', { n: product.leadDays })}</p> : null}
          {wu ? (
            <p class="warranty">🛡️ <a href={localePath(lang, '/policy')}>{t(lang, 'product.warranty', { n: wu.n, unit: t(lang, `warranty.unit.${wu.unit}`) })}</a>{wNote ? <span> — {wNote}</span> : null}</p>
          ) : null}
          {product.ports && product.ports.length ? <p class="compat-link">📱 <a href={localePath(lang, '/compat') + '?port=' + product.ports[0]}>{t(lang, 'product.checkCompat')}</a></p> : null}

          <p class="short">{product.shortDescription}</p>

          <div class="actions">
            {product.availability !== 'out_of_stock' ? (
              <button type="button" class="btn btn-cart" data-add-to-cart={product.id} data-name={product.name} data-stock={product.stock ?? undefined}>{t(lang, 'product.addToCart')}</button>
            ) : null}
            {product.whatsappOrder ? (
              <a class="btn btn-wa" href={waLink} target="_blank" rel="noopener">
                {t(lang, product.availability === 'out_of_stock' ? 'product.askAvailability' : 'product.orderWa')}
              </a>
            ) : null}
            <a class="btn btn-outline" href={phoneHref}>{t(lang, 'product.call')}</a>
            {cm.likesEnabled ? <button type="button" class="like" data-like={product.id} aria-pressed="false" aria-label={t(lang, 'community.like')} hidden><span class="heart" aria-hidden="true">♡</span><span class="lc" aria-hidden="true"></span></button> : null}
          </div>
          <p class="note">{t(lang, 'product.note')}</p>
        </div>
      </div>

      <div class="details">
        <section>
          <h2>{t(lang, 'product.description')}</h2>
          <p>{product.description}</p>
        </section>
        {specs.length ? (
          <section>
            <h2>{t(lang, 'product.specs')}</h2>
            <table class="specs">
              <tbody>
                {specs.map(([k, v]) => (
                  <tr><th scope="row">{k}</th><td>{v}</td></tr>
                ))}
              </tbody>
            </table>
          </section>
        ) : null}
      </div>

      <section class="reviews" id="reviews" aria-labelledby="rv-h" data-pid={product.id} data-tier={hasTier ? rv.tier : undefined} data-rv-count={rv.count} data-rv-points={rv.points} data-rv-sum={rv.sum} data-trusted={product.trusted ? '1' : undefined}>
        <h2 id="rv-h">{t(lang, 'reviews.title')}</h2>
        <p class="rv-sum" hidden={rv.count === 0}>
          <span class="st" set:html={starsHtml(rv.average)}></span>
          <strong class="avg">{fmtAvg(rv.average)}</strong> · <span class="sum-text">{t(lang, 'reviews.summary', { avg: fmtAvg(rv.average), count: rv.count })}</span>
          <span class="rv-tier">{hasTier ? t(lang, `reviews.tier.${rv.tier}`) : ''}</span>
        </p>
        <p class="note rv-explain" hidden={rv.count === 0}>{t(lang, 'reviews.explain')}</p>
        <p class="note rv-empty" hidden={rv.count > 0}>{t(lang, 'reviews.empty')}</p>
        <ul class="rv-list" id="rv-list">
          {reviews.map((r) => (
            <li class="rv">
              <div class="rv-h">
                <strong>{r.author ?? t(lang, 'reviews.customer')}</strong>
                {r.buyer === 'verified' ? <span class="rv-b">{t(lang, 'reviews.verified')}</span> : null}
                <span class="rv-s" role="img" aria-label={t(lang, 'reviews.stars', { n: r.rating })}>{stars(r.rating)}</span>
                {r.date ? <time datetime={r.date}>{r.date.slice(0, 10)}</time> : null}
              </div>
              {r.comment ? <p>{r.comment}</p> : null}
            </li>
          ))}
        </ul>
        {cm.reviewsEnabled ? <div id="rv-form-slot" hidden></div> : null}
      </section>
    </div>
  </section>

  {related.length ? (
    <section class="section section-alt" aria-labelledby="rel">
      <div class="container">
        <h2 id="rel">{t(lang, 'product.related')}</h2>
        <div class="grid grid-4">
          {related.map((p) => <ProductCard product={p} categoryName={catName[p.category]} lang={lang} />)}
        </div>
      </div>
    </section>
  ) : null}
</BaseLayout>

<style>
  .crumbs { font-size: 0.9rem; color: var(--c-muted); margin-bottom: 16px; }
  .crumbs a { color: var(--c-accent); text-decoration: none; }
  .layout { display: grid; gap: 24px; }
  .main { overflow: hidden; }
  .main img { width: 100%; aspect-ratio: 1; object-fit: contain; background: #fff; }
  .thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; }
  .thumb { border: 2px solid var(--c-border); border-radius: 10px; padding: 0; background: #fff; cursor: pointer; width: 76px; height: 76px; flex: none; overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb[aria-current='true'] { border-color: var(--c-accent); }
  .cat { font-size: 0.9rem; color: var(--c-muted); }
  h1 { margin: 4px 0; }
  .ref { color: var(--c-muted); font-size: 0.9rem; margin-bottom: 12px; }
  .offer-banner { margin: 0 0 10px; padding: 10px 12px; border-radius: 10px; background: #e8f0ff; color: var(--c-primary); font-weight: 600; line-height: 1.7; }
  .offer-banner[hidden] { display: none; }
  .prices { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin: 0 0 8px; }
  .price { font-size: 1.8rem; font-weight: 800; color: var(--c-accent); }
  .old { color: var(--c-muted); font-size: 1.05rem; }
  .save { background: var(--c-alert); color: #fff; font-weight: 700; font-size: 0.85rem; padding: 3px 12px; border-radius: 999px; }
  .lead-days, .warranty, .compat-link { margin: 8px 0 0; font-size: 0.95rem; color: var(--c-muted); }
  .warranty a, .compat-link a { color: var(--c-primary); font-weight: 700; }
  .low { margin-inline-start: 8px; color: var(--c-alert); font-weight: 700; font-size: 0.9rem; }
  .short { margin-top: 14px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  .note { color: var(--c-muted); font-size: 0.85rem; margin-top: 10px; }
  .details { display: grid; gap: 24px; margin-top: 32px; }
  .specs { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--c-border); border-radius: 10px; overflow: hidden; }
  .specs th, .specs td { text-align: start; padding: 10px 14px; border-bottom: 1px solid var(--c-border); }
  .specs th { width: 38%; background: var(--c-surface); color: var(--c-primary); font-weight: 600; }
  .reviews { margin-top: 32px; }
  .reviews[data-tier='green-dark'] { --tier-text: #166534; }
  .reviews[data-tier='green-light'] { --tier-text: #4d7c0f; }
  .reviews[data-tier='yellow'] { --tier-text: #854d0e; }
  .rv-sum { font-size: 1.1rem; margin: 0 0 4px; }
  .rv-sum[hidden], .rv-explain[hidden], .rv-empty[hidden] { display: none; }
  .rv-sum strong { color: #b45309; }
  .crown-line { margin: 4px 0 8px; }
  .crown-line[hidden] { display: none; }
  .rv-tier { margin-inline-start: 8px; font-weight: 700; color: var(--tier-text); }
  .rv-list { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 10px; }
  .rv { background: #fff; border: 1px solid var(--c-border); border-radius: 10px; padding: 12px 14px; }
  .rv p { margin: 6px 0 0; }
  .rv-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .rv-b { background: #dcfce7; color: #166534; font-size: 0.78rem; font-weight: 700; padding: 2px 10px; border-radius: 999px; }
  .rv-s { color: #b45309; letter-spacing: 1px; }
  .rv time { color: var(--c-muted); font-size: 0.85rem; }
  @media (min-width: 860px) {
    .layout { grid-template-columns: 1fr 1fr; align-items: start; gap: 40px; }
    .details { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const main = document.getElementById('main-img') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.thumb');
  thumbs.forEach((b) =>
    b.addEventListener('click', () => {
      if (!main || !b.dataset.src) return;
      main.src = b.dataset.src;
      thumbs.forEach((t) => t.removeAttribute('aria-current'));
      b.setAttribute('aria-current', 'true');
    })
  );
</script>
