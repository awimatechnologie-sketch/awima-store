---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReviewSummary } from '../../services/reviews';
import ProductCard from '../../components/ProductCard.astro';
import { getAllProducts, getCategories } from '../../services/products';
import { t, langOf, type Lang } from '../../i18n';

interface Props { lang?: Lang }
const lang = langOf(Astro.props.lang);
const products = getAllProducts(lang);
// نص الصفحة بالعربية والفرنسية معاً حتى يعمل البحث بأي من اللغتين
const otherById = new Map(getAllProducts(lang === 'fr' ? 'ar' : 'fr').map((p) => [p.id, p]));
const categories = getCategories(lang);
const catById = Object.fromEntries(categories.map((c) => [c.id, c]));
---
<BaseLayout
  lang={lang}
  title={t(lang, 'products.title')}
  description={t(lang, 'products.description')}
>
  <section class="section">
    <div class="container">
      <h1>{t(lang, 'products.title')}</h1>

      <div class="tools card">
        <label class="field grow">
          <span>{t(lang, 'products.search')}</span>
          <input id="q" type="search" placeholder={t(lang, 'products.searchPlaceholder')} autocomplete="off" />
        </label>
        <label class="field check">
          <input id="instock" type="checkbox" />
          <span>{t(lang, 'products.inStockOnly')}</span>
        </label>
        <label class="field">
          <span>{t(lang, 'products.sort')}</span>
          <select id="sort">
            <option value="default">{t(lang, 'products.sortDefault')}</option>
            <option value="price-asc">{t(lang, 'products.sortPriceAsc')}</option>
            <option value="price-desc">{t(lang, 'products.sortPriceDesc')}</option>
            <option value="name">{t(lang, 'products.sortName')}</option>
            <option value="rating">{t(lang, 'products.sortRating')}</option>
          </select>
        </label>
      </div>

      <div class="chips" id="chips" role="group" aria-label={t(lang, 'products.categories')}>
        <button type="button" class="chip" data-cat="" aria-pressed="true">{t(lang, 'products.all')}</button>
        {categories.map((c) => (
          <button type="button" class="chip" data-cat={c.slug} aria-pressed="false">{c.name}</button>
        ))}
      </div>

      <p class="count" id="count" aria-live="polite"></p>

      <ul class="grid grid-4 list" id="list">
        {products.map((p) => (
          <li
            data-name={p.name}
            data-text={[p.name, p.shortDescription, p.description, p.id, catById[p.category]?.name ?? '', ...Object.entries(p.specs).flat(), otherById.get(p.id)?.name ?? '', otherById.get(p.id)?.shortDescription ?? ''].join(' ')}
            data-av={p.availability}
            data-cat={catById[p.category]?.slug ?? ''}
            data-price={p.price ?? ''}
            data-rating={getReviewSummary(p.id).average}
            data-points={getReviewSummary(p.id).points}
          >
            <ProductCard product={p} categoryName={catById[p.category]?.name} lang={lang} />
          </li>
        ))}
      </ul>

      <div class="empty card" id="empty" hidden>
        <h2>{t(lang, 'products.none')}</h2>
        <p>{t(lang, 'products.tryOther')}</p>
        <button type="button" class="btn btn-outline" id="reset">{t(lang, 'products.reset')}</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { margin-bottom: 16px; }
  .tools { display: flex; flex-wrap: wrap; gap: 12px; padding: 12px; margin-bottom: 14px; }
  .field { display: grid; gap: 4px; font-size: 0.85rem; color: var(--c-muted); min-width: 150px; }
  .field.grow { flex: 1 1 220px; }
  .field.check { display: flex; align-items: center; gap: 8px; min-width: 0; align-self: end; padding-bottom: 10px; font-size: 0.95rem; color: var(--c-text); cursor: pointer; }
  .field.check input { width: 18px; height: 18px; padding: 0; }
  input, select {
    font: inherit; padding: 10px 12px; border: 1px solid var(--c-border);
    border-radius: 8px; background: #fff; color: var(--c-text); width: 100%;
  }
  .chips { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 8px; }
  .chip {
    font: inherit; font-weight: 600; white-space: nowrap; cursor: pointer;
    padding: 8px 16px; border-radius: 999px; border: 1px solid var(--c-border);
    background: #fff; color: var(--c-primary);
  }
  .chip[aria-pressed='true'] { background: var(--c-accent); border-color: var(--c-accent); color: #fff; }
  .count { color: var(--c-muted); font-size: 0.9rem; margin: 8px 0 12px; }
  .list { list-style: none; padding: 0; margin: 0; }
  .list > li[hidden] { display: none; }
  .empty { text-align: center; padding: 32px 16px; }
</style>

<script>
  import { normalize, matches } from '../../lib/search';
  import { t, langOf } from '../../i18n';

  const lang = langOf(document.documentElement.lang);

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const q = $<HTMLInputElement>('q');
  const sortEl = $<HTMLSelectElement>('sort');
  const list = $<HTMLUListElement>('list');
  const empty = $('empty');
  const count = $('count');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const items = Array.from(list.children) as HTMLLIElement[];
  const original = [...items];

  // نص كل منتج بعد التوحيد (يُحسب مرة واحدة): العربية والفرنسية والتشكيل والأرقام الهندية
  const haystack = new Map(original.map((li) => [li, normalize(li.dataset.text ?? '')]));
  const instock = $<HTMLInputElement>('instock');

  let cat = '';

  function apply() {
    let visible = original.filter((li) => {
      const okCat = !cat || li.dataset.cat === cat;
      const okText = matches(q.value, haystack.get(li) ?? '');
      const okStock = !instock.checked || li.dataset.av !== 'out_of_stock';
      return okCat && okText && okStock;
    });

    const price = (li: HTMLLIElement) =>
      li.dataset.price === '' ? null : Number(li.dataset.price);
    const mode = sortEl.value;
    if (mode === 'price-asc' || mode === 'price-desc') {
      const dir = mode === 'price-asc' ? 1 : -1;
      visible = [...visible].sort((a, b) => {
        const pa = price(a), pb = price(b);
        if (pa === null && pb === null) return 0;
        if (pa === null) return 1; // بدون سعر في النهاية
        if (pb === null) return -1;
        return (pa - pb) * dir;
      });
    } else if (mode === 'rating') {
      // الأعلى تقييماً (متوسط مرجّح) ثم الأكثر نقاطاً؛ بلا تقييم في النهاية
      const key = (li: HTMLLIElement) => [Number(li.dataset.rating || 0), Number(li.dataset.points || 0)];
      visible = [...visible].sort((a, b) => {
        const [ra, pa] = key(a), [rb, pb] = key(b);
        return rb - ra || pb - pa;
      });
    } else if (mode === 'name') {
      visible = [...visible].sort((a, b) =>
        (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'ar')
      );
    }

    original.forEach((li) => (li.hidden = !visible.includes(li)));
    visible.forEach((li) => list.appendChild(li));
    empty.hidden = visible.length > 0;
    list.hidden = visible.length === 0;
    count.textContent = t(lang, 'products.count', { n: visible.length });

    const params = new URLSearchParams();
    if (cat) params.set('category', cat);
    if (q.value.trim()) params.set('q', q.value.trim());
    if (instock.checked) params.set('instock', '1');
    if (mode !== 'default') params.set('sort', mode);
    const qs = params.toString();
    history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : ''));
  }

  function setCat(slug: string) {
    cat = slug;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.cat === slug)));
  }

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      setCat(c.dataset.cat ?? '');
      apply();
    })
  );
  q.addEventListener('input', apply);
  sortEl.addEventListener('change', apply);
  instock.addEventListener('change', apply);
  $('reset').addEventListener('click', () => {
    q.value = '';
    sortEl.value = 'default';
    instock.checked = false;
    setCat('');
    apply();
  });

  // قراءة الحالة من الرابط
  const params = new URLSearchParams(location.search);
  const urlCat = params.get('category') ?? '';
  setCat(chips.some((c) => c.dataset.cat === urlCat) ? urlCat : '');
  q.value = params.get('q') ?? '';
  instock.checked = params.get('instock') === '1';
  const urlSort = params.get('sort');
  if (urlSort && Array.from(sortEl.options).some((o) => o.value === urlSort)) sortEl.value = urlSort;
  apply();

  // الرابط /products#q (من أيقونة البحث في الهيدر) يضع المؤشر في خانة البحث
  if (location.hash === '#q') q.focus();
</script>
