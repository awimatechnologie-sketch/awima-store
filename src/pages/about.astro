---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { buildContactLink } from '../lib/whatsapp';
import aboutAr from '../data/pages/about.json';
import aboutFr from '../data/pages/about.fr.json';
import { t, langOf, localePath, type Lang } from '../i18n';

interface Props { lang?: Lang }
const lang = langOf(Astro.props.lang);
const about = lang === 'fr' ? aboutFr : aboutAr;

// فقرات من النص: السطر الفارغ يفصل بين فقرتين
const paragraphs = (txt?: string) =>
  (txt ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const goals: string[] = (about.goals ?? []).filter(Boolean);
---
<BaseLayout lang={lang} title={about.title} description={about.intro}>
  <section class="section">
    <div class="container narrow">
      <h1>{about.title}</h1>
      {paragraphs(about.intro).map((p) => <p class="lead">{p}</p>)}

      {about.image && <img class="hero-img" src={about.image} alt={site.name} loading="lazy" />}

      {about.mission && (
        <>
          <h2>{t(lang, 'about.mission')}</h2>
          {paragraphs(about.mission).map((p) => <p>{p}</p>)}
        </>
      )}

      {goals.length > 0 && (
        <>
          <h2>{t(lang, 'about.goals')}</h2>
          <ul class="goals">{goals.map((g) => <li>{g}</li>)}</ul>
        </>
      )}

      {about.philosophy && (
        <>
          <h2>{t(lang, 'about.philosophy')}</h2>
          {paragraphs(about.philosophy).map((p) => <p>{p}</p>)}
        </>
      )}

      <div class="actions">
        <a class="btn btn-wa" href={buildContactLink(undefined, lang)} target="_blank" rel="noopener">{t(lang, 'about.contactWa')}</a>
        <a class="btn btn-outline" href={localePath(lang, '/products')}>{t(lang, 'about.browse')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .narrow { max-width: 760px; }
  h1 { margin-block: 0 12px; color: var(--c-primary); }
  h2 { margin-block: 28px 8px; color: var(--c-primary); font-size: 1.2rem; }
  .lead { font-size: 1.1rem; color: var(--c-text); }
  p { line-height: 1.9; color: var(--c-muted); margin-block: 0 12px; }
  .lead { color: var(--c-text); }
  .goals { padding-inline-start: 20px; line-height: 2; color: var(--c-muted); }
  .hero-img { width: 100%; height: auto; border-radius: var(--radius); margin-block: 16px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
</style>
