---
import '../styles/global.css';
import Header from '../components/Header.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Footer from '../components/Footer.astro';
import { site, localizedSite } from '../config/site';
import { langOf, dirOf, alternatePath, type Lang } from '../i18n';
import { getAllProducts } from '../services/products';
import { BEACON_SRC, beaconAttr } from '../lib/analytics';

interface Props { title?: string; description?: string; image?: string; ogType?: string; lang?: Lang; alternates?: boolean }
const { title, description: descProp, image = site.logo.og, ogType = 'website', lang: langProp, alternates = true } = Astro.props;
const lang = langOf(langProp);
const ls = localizedSite(lang);
const description = descProp ?? ls.tagline;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${ls.tagline}`;
// روابط النسخة العربية/الفرنسية لنفس الصفحة (hreflang)
const altUrl = (l: Lang) => new URL(alternatePath(Astro.url.pathname, l), site.url).href;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
// معرّفات المنتجات الظاهرة: تُستعمل لتنظيف سلة الزبون من منتجات حُذفت
const validIds = getAllProducts().map((p) => p.id).join(',');
// الإحصائيات تعمل في الموقع المنشور فقط (ليس أثناء التطوير المحلي) وبشرط وجود توكن صالح
const beacon = import.meta.env.PROD ? beaconAttr(site.analytics.cloudflareToken) : null;
// ألوان العلامة من الإعدادات (html:root لضمان أولويتها على global.css)
const themeCss = `html:root{--c-primary:${site.colors.primary};--c-accent:${site.colors.accent};--c-alert:${site.colors.alert};}`;
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && <link rel="alternate" hreflang="ar" href={altUrl('ar')} />}
    {alternates && <link rel="alternate" hreflang="fr" href={altUrl('fr')} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={altUrl('ar')} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href={site.logo.icon} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_MA' : 'ar_MA'} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={site.colors.primary} />
    <style is:inline set:html={themeCss}></style>
    {site.customCss ? <style is:inline set:html={site.customCss}></style> : null}
    <slot name="head" />
  </head>
  <body data-valid-ids={validIds}>
    <AnnouncementBar lang={lang} />
    <Header lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} />
    <script>
      import '../scripts/site';
    </script>
    {beacon ? <script is:inline defer src={BEACON_SRC} data-cf-beacon={beacon}></script> : null}
  </body>
</html>

<style is:global>
  [hidden] { display: none !important; }
  .toast {
    position: fixed; inset-inline: 16px; bottom: 20px; margin-inline: auto; width: fit-content; max-width: calc(100% - 32px);
    background: var(--c-primary); color: #fff; padding: 10px 18px; border-radius: 999px; font-weight: 600;
    box-shadow: var(--shadow); opacity: 0; transform: translateY(12px); pointer-events: none; transition: opacity 0.2s, transform 0.2s; z-index: 50;
  }
  .toast.show { opacity: 1; transform: none; }
  .btn-cart { background: var(--c-primary); color: #fff; }
  .btn-cart:hover { background: var(--c-accent); }
  .btn[disabled] { opacity: 0.55; cursor: not-allowed; }
</style>
